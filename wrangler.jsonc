// One Cloudflare Worker serves the site (static files from dist/), the /api
// routes and the scheduled price job.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warera-planner",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so client-side routes work on reload.
    "not_found_handling": "single-page-application",
    // /api is always handled by the Worker, never by a static file.
    "run_worker_first": ["/api/*"]
  },
  // Game config, item prices and the equipment trade history (tables are created by the job).
  "d1_databases": [
    { "binding": "DB", "database_name": "warera-prices", "database_id": "d4819384-059f-4cb2-bac1-5b5015bc857c" }
  ],
  // Every minute; each run refreshes a small slice (see worker/job.js).
  "triggers": { "crons": ["* * * * *"] },
  // The API key is a secret (WARERA_API_KEY), set in the dashboard, never in this file.
  "observability": { "enabled": true }
}
